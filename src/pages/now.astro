---
import BaseLayout from '../layouts/BaseLayout.astro';
import NowWorkingOn from '../components/now/NowWorkingOn.astro';
import NowReading from '../components/now/NowReading.astro';
import NowStack from '../components/now/NowStack.astro';
import { siteUpdatedDate } from '../data/time';

const workingOn = [
  {
    title: 'AutoJsOpen · 手机自动化平台',
    detail:
      'Compose + Miuix KMP 全栈 UI 重构，Rhino JS 引擎接入，ACE 编辑器字体缩放与双指手势打磨。',
    status: '进行中',
    tag: 'Android',
  },
  {
    title: 'AI 视频创作工作流',
    detail:
      'Remotion + Canvas + Playwright 逐帧渲染管线，Python 从零合成配乐，已产出《记忆的谎言》科普短片。',
    status: '进行中',
    tag: '创作',
  },
  {
    title: 'Operit Skill 库与逆向工程',
    detail: 'GitHub 高星项目蒸馏、APK 逆向、Frida Hook 与 skill 沉淀，持续扩充可复用的能力库。',
    status: '持续中',
    tag: '逆向',
  },
];

const reading = [
  { title: 'Jetpack Compose + Miuix KMP 实战', kind: 'Android' },
  { title: 'Remotion / 代码驱动视频', kind: '创作' },
  { title: '逆向工程与 Frida 动态分析', kind: '逆向' },
  { title: 'AI Agent 工作流与工具设计', kind: 'AI' },
];

const stack = [
  { name: 'Termux (ARM64)', role: '主力开发环境' },
  { name: 'Kotlin + Compose', role: '移动端开发' },
  { name: 'Miuix KMP', role: 'UI 组件库' },
  { name: 'Rhino / Node.js', role: 'JS 引擎' },
  { name: 'Remotion / Playwright', role: '视频渲染' },
  { name: 'Astro', role: '个人主站框架' },
];
---

<BaseLayout title="Now · Azek431" description="Azek431 最近正在做的事情、关注方向和日常工具。">
  <section class="section">
    <!-- Hero -->
    <div class="section-heading">
      <p class="eyebrow">Now</p>
      <h1>现在在做的事</h1>
      <p>
        这一页记录我最近关注的方向、正在做的项目、最近读到的内容和日常使用的工具。它比 About
        更具体，比 Blog 更轻量。
      </p>
    </div>

    <!-- Status -->
    <div class="projects-summary">
      <div class="projects-summary__item">
        <span>最近更新</span>
        <strong>{siteUpdatedDate}</strong>
      </div>
      <div class="projects-summary__item">
        <span>地点</span>
        <strong>线上 / GitHub</strong>
      </div>
      <div class="projects-summary__item">
        <span>方向</span>
        <strong>Web · AI · Open</strong>
      </div>
    </div>

    <!-- Working On -->
    <div class="section-heading">
      <p class="eyebrow">Working On</p>
      <h2>正在推进</h2>
      <p class="section-subtitle">这几条是当前优先级最高的方向。</p>
    </div>

    <NowWorkingOn items={workingOn} />

    <!-- Reading -->
    <div class="section-heading">
      <p class="eyebrow">Reading</p>
      <h2>最近关注</h2>
      <p class="section-subtitle">不一定都是技术，也可能是设计、产品、开发流程或项目维护方法。</p>
    </div>

    <NowReading items={reading} />

    <!-- Stack -->
    <div class="section-heading">
      <p class="eyebrow">Stack</p>
      <h2>日常工具</h2>
      <p class="section-subtitle">稳定、长期、可维护优先。</p>
    </div>

    <NowStack items={stack} />
  </section>
</BaseLayout>
