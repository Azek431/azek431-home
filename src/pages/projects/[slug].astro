---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectDetails, type ProjectDetail } from '../../data/projects';
import { siteConfig } from '../../data/site';

type DetailLink = {
  label: string;
  href: string;
  primary?: boolean;
  external: boolean;
};

export function getStaticPaths() {
  return projectDetails.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: ProjectDetail };

if (!project) {
  return Astro.redirect('/projects/');
}

const index = projectDetails.findIndex((item) => item.slug === project.slug);
const prevProject =
  index > 0 ? projectDetails[index - 1] : projectDetails[projectDetails.length - 1];
const nextProject =
  index < projectDetails.length - 1 ? projectDetails[index + 1] : projectDetails[0];

const allTags = project.tags || [];
const features = project.features || [];
const highlights = project.highlights || [];

const links: DetailLink[] = [];

if (project.websiteUrl) {
  links.push({
    label: '访问网站',
    href: project.websiteUrl,
    primary: true,
    external: true,
  });
}

if (project.githubUrl) {
  links.push({
    label: 'GitHub 仓库',
    href: project.githubUrl,
    external: true,
  });
}

if (project.giteeUrl) {
  links.push({
    label: 'Gitee 镜像',
    href: project.giteeUrl,
    external: true,
  });
}

const sharedTags = (a: ProjectDetail, b: ProjectDetail) =>
  (a.tags || []).filter((tag) => (b.tags || []).includes(tag)).length;

// 改进的相关项目算法：考虑分类、标签共享、状态相似性
const relatedProjects = projectDetails
  .filter((item) => item.slug !== project.slug)
  .map((item) => {
    let score = 0;
    if (item.category === project.category) score += 3;
    if (item.status === project.status) score += 2;
    score += sharedTags(item, project);
    return { project: item, score };
  })
  .filter((item) => item.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map((item) => item.project);
---

<BaseLayout
  title={`${project.title} · Azek431`}
  description={project.description}
  type={project.status === '已上线' ? 'article' : 'website'}
  publishedTime={project.lastUpdated}
  modifiedTime={project.lastUpdated}
>
  <section class="section">
    <!-- Hero -->
    <div class="detail-hero">
      <p class="eyebrow">Project · {project.category}</p>
      <h1>{project.title}</h1>
      <p>{project.description}</p>

      <div class="detail-meta">
        <span class="tag tag-accent">{project.status}</span>
        {project.lastUpdated && <span class="tag">更新于 {project.lastUpdated}</span>}
        {allTags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
      </div>

      <div class="detail-links">
        {
          links.map((link) => (
            <a
              class={link.primary ? 'button button-primary' : 'button button-secondary'}
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Screenshot Preview -->
    {
      project.screenshotUrl && (
        <div style="margin-bottom: var(--space-10);">
          <div class="section-heading">
            <p class="eyebrow">Preview</p>
            <h2>项目预览</h2>
          </div>
          <div class="detail-screenshot">
            <img
              src={project.screenshotUrl}
              alt={`${project.title} 截图`}
              loading="lazy"
              width={800}
              height={450}
            />
          </div>
        </div>
      )
    }

    <!-- Highlights -->
    {
      highlights.length > 0 && (
        <div class="detail-sidebar" style="margin-bottom: var(--space-10);">
          <div class="detail-sidebar__card">
            <h3>Highlights</h3>
            <ul class="detail-stats">
              {highlights.map((item) => (
                <li>
                  <span class="label">{item.label}</span>
                  <span class="value">{item.value}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }

    <!-- Description -->
    <div class="detail-grid">
      <article class="detail-content">
        <h2>项目说明</h2>
        <p>{project.longDescription || project.description}</p>
      </article>

      <aside class="detail-sidebar">
        <div class="detail-sidebar__card">
          <h3>Tech Stack</h3>
          <ul class="detail-stats">
            {
              allTags.map((tag) => (
                <li>
                  <span class="label">{tag}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    <!-- Features -->
    {
      features.length > 0 && (
        <div style="margin-top: var(--space-10);">
          <div class="section-heading">
            <p class="eyebrow">Features</p>
            <h2>特性 / 亮点</h2>
            <span style="font-size: var(--text-sm); color: var(--color-text-muted);">
              这些是这个项目当前最值得关注的部分。
            </span>
          </div>

          <div class="detail-features">
            {features.map((feature, featureIndex) => (
              <li>
                <span style="font-size: var(--text-xs); color: var(--color-text-faint); font-family: ui-monospace, monospace;">
                  {String(featureIndex + 1).padStart(2, '0')}
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </div>
        </div>
      )
    }

    <!-- Related Projects -->
    {
      relatedProjects.length > 0 && (
        <div style="margin-top: var(--space-10);">
          <div class="section-heading">
            <p class="eyebrow">Related</p>
            <h2>相关项目</h2>
            <span style="font-size: var(--text-sm); color: var(--color-text-muted);">
              根据分类、状态和标签匹配到的其他项目。
            </span>
          </div>

          <div class="card-grid">
            {relatedProjects.map((item) => (
              <a
                class="card"
                href={`/projects/${item.slug}/`}
                style="text-decoration: none; color: var(--color-text);"
              >
                <span class="tag">{item.category}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="tag tag-accent" style="margin-top: auto;">
                  {item.status}
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- 联系与关注 -->
    <div style="margin-top: var(--space-10);">
      <div class="section-heading">
        <p class="eyebrow">Connect</p>
        <h2>联系与关注</h2>
        <span style="font-size: var(--text-sm); color: var(--color-text-muted);">
          喜欢这个项目或有问题，欢迎通过下面的入口找到我。
        </span>
      </div>
      <div class="card-grid connect-grid">
        <a
          class="card connect-card"
          href={siteConfig.telegram}
          target="_blank"
          rel="noopener noreferrer"
          style="text-decoration: none; color: var(--color-text);"
        >
          <span class="connect-card__label">Telegram 频道</span>
          <span class="connect-card__value">{siteConfig.telegramHandle}</span>
          <span class="connect-card__hint">更新动态 · 项目发布 ↗</span>
        </a>
        <a
          class="card connect-card"
          href={siteConfig.emailHref}
          style="text-decoration: none; color: var(--color-text);"
        >
          <span class="connect-card__label">邮箱</span>
          <span class="connect-card__value">{siteConfig.email}</span>
          <span class="connect-card__hint">商务合作 · 问题反馈</span>
        </a>
        <a
          class="card connect-card"
          href={siteConfig.github}
          target="_blank"
          rel="noopener noreferrer"
          style="text-decoration: none; color: var(--color-text);"
        >
          <span class="connect-card__label">GitHub</span>
          <span class="connect-card__value">Azek431</span>
          <span class="connect-card__hint">开源记录 · 代码仓库 ↗</span>
        </a>
      </div>
    </div>

    <!-- Navigation -->
    <nav
      class="project-neighbor"
      aria-label="项目切换"
      style="display: flex; gap: var(--space-4); margin-top: var(--space-10); justify-content: space-between; flex-wrap: wrap;"
    >
      <a
        href={`/projects/${prevProject.slug}/`}
        style="font-size: var(--text-sm); color: var(--color-text-muted);"
      >
        ← {prevProject.title}
      </a>
      <a href="/projects/" style="font-size: var(--text-sm); color: var(--color-text-muted);">
        项目列表
      </a>
      <a
        href={`/projects/${nextProject.slug}/`}
        style="font-size: var(--text-sm); color: var(--color-text-muted);"
      >
        {nextProject.title} →
      </a>
    </nav>
  </section>
</BaseLayout>
