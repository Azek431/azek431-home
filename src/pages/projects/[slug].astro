---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { projectDetails, type ProjectDetail } from '../../data/projects';

type DetailLink = {
  label: string;
  href: string;
  primary?: boolean;
  external: boolean;
};

export function getStaticPaths() {
  return projectDetails.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: ProjectDetail };

if (!project) {
  return Astro.redirect('/projects/');
}

const index = projectDetails.findIndex((item) => item.slug === project.slug);
const prevProject =
  index > 0 ? projectDetails[index - 1] : projectDetails[projectDetails.length - 1];
const nextProject =
  index < projectDetails.length - 1 ? projectDetails[index + 1] : projectDetails[0];

const allTags = project.tags || [];
const features = project.features || [];
const highlights = project.highlights || [];

const links: DetailLink[] = [];

if (project.websiteUrl) {
  links.push({
    label: '访问网站',
    href: project.websiteUrl,
    primary: true,
    external: true,
  });
}

if (project.githubUrl) {
  links.push({
    label: 'GitHub 仓库',
    href: project.githubUrl,
    external: true,
  });
}

if (project.giteeUrl) {
  links.push({
    label: 'Gitee 镜像',
    href: project.giteeUrl,
    external: true,
  });
}

const sharedTags = (a: ProjectDetail, b: ProjectDetail) =>
  (a.tags || []).filter((tag) => (b.tags || []).includes(tag)).length;

const relatedProjects = projectDetails
  .filter((item) => item.slug !== project.slug)
  .map((item) => ({
    project: item,
    score: (item.category === project.category ? 3 : 0) + sharedTags(item, project),
  }))
  .sort((a, b) => b.score - a.score)
  .slice(0, 2)
  .map((item) => item.project);
---

<BaseLayout title={`${project.title} · Azek431`} description={project.description}>
  <section class="section">
    <!-- Hero -->
    <div class="detail-hero">
      <p class="eyebrow">Project · {project.category}</p>
      <h1>{project.title}</h1>
      <p>{project.description}</p>

      <div class="detail-meta">
        <span class="tag tag-accent">{project.status}</span>
        {project.lastUpdated && <span class="tag">更新于 {project.lastUpdated}</span>}
        {allTags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
      </div>

      <div class="detail-links">
        {
          links.map((link) => (
            <a
              class={link.primary ? 'button button-primary' : 'button button-secondary'}
              href={link.href}
              target={link.external ? '_blank' : undefined}
              rel={link.external ? 'noreferrer' : undefined}
            >
              {link.label}
            </a>
          ))
        }
      </div>
    </div>

    <!-- Highlights -->
    {
      highlights.length > 0 && (
        <div class="detail-sidebar section-spacer">
          <div class="detail-sidebar__card">
            <h3>Highlights</h3>
            <ul class="detail-stats">
              {highlights.map((item) => (
                <li>
                  <span class="label">{item.label}</span>
                  <span class="value">{item.value}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      )
    }

    <!-- Description -->
    <div class="detail-grid">
      <article class="detail-content">
        <h2>项目说明</h2>
        <p>{project.longDescription || project.description}</p>
      </article>

      <aside class="detail-sidebar">
        <div class="detail-sidebar__card">
          <h3>Tech Stack</h3>
          <ul class="detail-stats">
            {
              allTags.map((tag) => (
                <li>
                  <span class="label">{tag}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </aside>
    </div>

    <!-- Features -->
    {
      features.length > 0 && (
        <div style="margin-top: var(--space-10);">
          <div class="section-heading">
            <p class="eyebrow">Features</p>
            <h2>特性 / 亮点</h2>
            <span class="section-subtitle">
              这些是这个项目当前最值得关注的部分。
            </span>
          </div>

          <div class="detail-features">
            {features.map((feature, featureIndex) => (
              <li>
                <span class="feature-index">
                  {String(featureIndex + 1).padStart(2, '0')}
                </span>
                <span>{feature}</span>
              </li>
            ))}
          </div>
        </div>
      )
    }

    <!-- Related Projects -->
    {
      relatedProjects.length > 0 && (
        <div class="section-spacer">
          <div class="section-heading">
            <p class="eyebrow">Related</p>
            <h2>相关项目</h2>
            <span class="section-subtitle">
              根据分类和标签匹配到的其他项目。
            </span>
          </div>

          <div class="card-grid">
            {relatedProjects.map((item) => (
              <a
                class="card card-link"
                href={`/projects/${item.slug}/`}
              >
                <span class="tag">{item.category}</span>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
                <span class="tag tag-accent" style="margin-top: auto;">
                  {item.status}
                </span>
              </a>
            ))}
          </div>
        </div>
      )
    }

    <!-- Navigation -->
    <nav class="project-nav" aria-label="项目切换">
      <a class="project-nav-link" href={`/projects/${prevProject.slug}/`}>
        ← {prevProject.title}
      </a>
      <a class="project-nav-link" href="/projects/">
        项目列表
      </a>
      <a class="project-nav-link" href={`/projects/${nextProject.slug}/`}>
        {nextProject.title} →
      </a>
    </nav>
  </section>
</BaseLayout>
