---
type NowItem = {
  status: string;
  title: string;
  desc: string;
};

type Props = {
  items: NowItem[];
};

const { items } = Astro.props as Props;
---

<div class="card-grid">
  {
    items.map((item) => (
      <div class="card">
        <div class="card-tags-row">
          <span class="tag tag-accent">{item.status}</span>
        </div>
        <h3>{item.title}</h3>
        <p>{item.desc}</p>
      </div>
    ))
  }
</div>
