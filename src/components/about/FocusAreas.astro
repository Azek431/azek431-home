---
type FocusItem = {
  num: string;
  title: string;
  desc: string;
};

type Props = {
  items: FocusItem[];
};

const { items } = Astro.props as Props;
---

<div class="about-dashboard__card">
  <h3>Focus Areas</h3>
  <div class="card-grid" style="grid-template-columns: 1fr;">
    {
      items.map((item) => (
        <div class="card" style="padding: var(--space-4);">
          <span style="font-size: var(--text-xs); font-family: ui-monospace, monospace; color: var(--color-text-faint);">
            {item.num}
          </span>
          <h3 style="font-size: var(--text-base); margin-top: var(--space-1);">{item.title}</h3>
          <p style="font-size: var(--text-sm); color: var(--color-text-muted);">{item.desc}</p>
        </div>
      ))
    }
  </div>
</div>
