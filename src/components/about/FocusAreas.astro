---
type FocusItem = {
  num: string;
  title: string;
  desc: string;
};

type Props = {
  items: FocusItem[];
};

const { items } = Astro.props as Props;
---

<div class="about-dashboard__card">
  <h3>Focus Areas</h3>
  <div class="card-grid card-grid--single">
    {
      items.map((item) => (
        <div class="card card--compact">
          <span class="focus-num">{item.num}</span>
          <h3 class="focus-title">{item.title}</h3>
          <p class="focus-desc">{item.desc}</p>
        </div>
      ))
    }
  </div>
</div>
