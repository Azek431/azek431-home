---
type DraftItem = {
  title: string;
  desc: string;
  tag: string;
  est: string;
};

type Props = {
  items: DraftItem[];
};

const { items } = Astro.props;
---

<div class="card-grid">
  {
    items.map((draft) => (
      <div class="card">
        <div style="display: flex; gap: var(--space-2); margin-bottom: var(--space-2);">
          <span class="tag">{draft.tag}</span>
          <span style="font-size: var(--text-xs); color: var(--color-text-faint);">
            {draft.est}
          </span>
        </div>
        <h3>{draft.title}</h3>
        <p>{draft.desc}</p>
      </div>
    ))
  }
</div>
