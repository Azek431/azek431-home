---
type DraftItem = {
  title: string;
  desc: string;
  tag: string;
  est: string;
};

type Props = {
  items: DraftItem[];
};

const { items } = Astro.props;
---

<div class="card-grid">
  {
    items.map((draft) => (
      <div class="card">
        <div class="card-tags-row">
          <span class="tag">{draft.tag}</span>
          <span class="est-date">{draft.est}</span>
        </div>
        <h3>{draft.title}</h3>
        <p>{draft.desc}</p>
      </div>
    ))
  }
</div>
