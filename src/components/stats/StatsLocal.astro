---
type Props = {
  sessionCount: number;
  totalCount: number;
  firstVisit: string;
};

const { sessionCount, totalCount, firstVisit } = Astro.props as Props;
---

<div class="section-heading">
  <p class="eyebrow">Local</p>
  <h2>本地访问统计</h2>
  <p class="section-subtitle">这些数据只保存在你的浏览器 localStorage 中，不会上传。</p>
</div>

<div class="projects-summary">
  <div class="projects-summary__item">
    <span>本次会话</span>
    <dd data-local-stat="session">{sessionCount} 次</dd>
  </div>
  <div class="projects-summary__item">
    <span>累计访问</span>
    <dd data-local-stat="total">{totalCount} 次</dd>
  </div>
  <div class="projects-summary__item">
    <span>首次访问</span>
    <dd data-local-stat="first">{firstVisit || '—'}</dd>
  </div>
</div>
