---
type Metric = {
  label: string;
  value: string | number;
  suffix?: string;
};

type Props = {
  kicker: string;
  title: string;
  value: string | number;
  suffix?: string;
  desc: string;
  metrics: Metric[];
};

const { kicker, title, value, suffix, desc, metrics } = Astro.props as Props;
---

<div class="card">
  <div>
    <p class="eyebrow">{kicker}</p>
    <h2 class="stat-title">{title}</h2>
    <span class="stat-description">{desc}</span>
  </div>

  <strong class="stat-value">
    {value}
    {suffix && <small style="font-size: var(--text-sm); font-weight: 400;">{suffix}</small>}
  </strong>

  <dl>
    {
      metrics.map((metric) => (
        <div>
          <dt>{metric.label}</dt>
          <dd>
            {metric.value}
            {metric.suffix && <small>{metric.suffix}</small>}
          </dd>
        </div>
      ))
    }
  </dl>
</div>
