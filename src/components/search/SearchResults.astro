---
type SearchResultItem = {
  category: string;
  title: string;
  desc: string;
  href: string;
  tags?: string[];
};

type Props = {
  items: SearchResultItem[];
};

const { items } = Astro.props;
---

<div class="search-results" aria-live="polite">
  <p data-search-hint class="search-hint">输入关键词开始搜索，也可以直接点击分类查看索引。</p>

  <ol data-search-results>
    {
      items.slice(0, 30).map((item) => (
        <li data-search-static>
          <a class="search-result" href={item.href}>
            <span>{item.category}</span>
            <strong>{item.title}</strong>
            <small>{item.desc}</small>
          </a>
        </li>
      ))
    }
  </ol>

  <div data-search-empty class="search-empty-state" hidden>
    <h2>没有匹配的结果</h2>
    <p>试试换一个关键词，或直接查看项目、链接和更新日志。</p>
    <div class="search-empty-actions">
      <a class="button button-secondary" href="/projects/">所有项目</a>
      <a class="button button-secondary" href="/links/">链接集合</a>
      <a class="button button-secondary" href="/changelog/">更新日志</a>
    </div>
  </div>
</div>
