---
type Props = {
  placeholder?: string;
};

const { placeholder = '搜索项目、链接、页面、更新...' } = Astro.props;
---

<div class="search-console" role="search" style="position: relative; overflow: hidden;">
  <div
    style="position: absolute; left: 0; top: 0; bottom: 0; width: 3px; background: var(--gradient-accent); border-radius: 2px 0 0 2px;"
  >
  </div>
  <div
    style="display: flex; align-items: center; gap: var(--space-3); padding-left: var(--space-4);"
  >
    <span style="font-size: var(--text-lg); color: var(--color-text-faint);" aria-hidden="true"
      >/</span
    >
    <label for="site-search" class="sr-only">站内搜索</label>
    <input
      id="site-search"
      type="search"
      placeholder={placeholder}
      autocomplete="off"
      data-search-input
      aria-label="站内搜索"
    />
  </div>
</div>
