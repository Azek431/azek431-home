---
import RuntimeCounter from './RuntimeCounter.astro';
import { siteConfig } from '../data/site';
import { getSiteAge, siteStartedAtIso, siteStartedDateTime } from '../data/time';

const year = new Date().getFullYear();
const siteAge = getSiteAge();

const primaryLinks = [
  { label: '首页', href: '/' },
  { label: '项目', href: '/projects/' },
  { label: '链接', href: '/links/' },
  { label: '搜索', href: '/search/' },
];

const secondaryLinks = [
  { label: 'About', href: '/about/' },
  { label: 'Now', href: '/now/' },
  { label: 'Uses', href: '/uses/' },
  { label: 'Changelog', href: '/changelog/' },
];

const publicLinks = [
  { label: 'GitHub', href: siteConfig.github, icon: 'github' },
  { label: 'Gitee', href: siteConfig.gitee, icon: 'gitee' },
  { label: 'RSS', href: '/rss.xml', icon: 'rss' },
];

const contactLinks = [
  { label: siteConfig.email, href: siteConfig.emailHref, icon: 'email' },
  { label: `Telegram · ${siteConfig.telegramHandle}`, href: siteConfig.telegram, icon: 'telegram' },
];

const isExternal = (href: string) => href.startsWith('http');
---

<footer class="site-footer" aria-label="站点页脚">
  <div class="footer-inner">
    <div class="footer__brand">
      <h3>{siteConfig.name}</h3>
      <p>个人数字空间 — 连接项目、学习记录、AI 实验与公开入口。</p>
    </div>

    <nav class="footer__nav" aria-label="页脚导航">
      <div class="footer__column">
        <h4>导航</h4>
        <ul>
          {
            primaryLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__column">
        <h4>记录</h4>
        <ul>
          {
            secondaryLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__column">
        <h4>公开</h4>
        <ul>
          {
            publicLinks.map((link) => (
              <li>
                <a
                  class="footer__link--external"
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                  aria-label={`${link.label}（外部链接）`}
                >
                  {link.label}
                  {link.icon === 'github' && (
                    <svg
                      class="footer__icon"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z" />
                    </svg>
                  )}
                  {link.icon === 'gitee' && (
                    <svg
                      class="footer__icon"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z" />
                    </svg>
                  )}
                  {link.icon === 'rss' && (
                    <svg
                      class="footer__icon"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16M6 19a2 2 0 0 0 2-2 2 2 0 0 0-2-2 2 2 0 0 0-2 2 2 2 0 0 0 2 2z" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="footer__column">
        <h4>联系</h4>
        <ul>
          {
            contactLinks.map((link) => (
              <li>
                <a
                  class="footer__link--external"
                  href={link.href}
                  target={isExternal(link.href) ? '_blank' : undefined}
                  rel={isExternal(link.href) ? 'noopener noreferrer' : undefined}
                  aria-label={`${link.label}`}
                >
                  {link.label}
                  {link.icon === 'telegram' && (
                    <svg
                      class="footer__icon"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                    >
                      <path d="M21.94 4.33 18.9 18.35c-.23 1.02-.83 1.27-1.68.79l-4.64-3.42-2.24 2.16c-.25.25-.46.46-.95.46l.33-4.71 8.57-7.74c.38-.34-.08-.53-.6-.19l-10.57 6.66-4.53-1.41c-.98-.31-1-.97.2-1.8l17.48-10.75c.82-.48 1.59.28 1.34 1.42ZM13.8 13.5l-.77 9.13c.11.89.77.9 1.57.02l2.6-2.55-4.2-3.64Z" />
                    </svg>
                  )}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>

  <div class="footer__bottom">
    <span>© {year} {siteConfig.name}</span>
    <span>
      Started {siteStartedDateTime} · Running <RuntimeCounter
        startedAt={siteStartedAtIso}
        fallback={siteAge.preciseLabel}
        className="footer__runtime"
      />
    </span>
  </div>
</footer>
