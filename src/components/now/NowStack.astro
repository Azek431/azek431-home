---
type StackItem = {
  name: string;
  role: string;
};

type Props = {
  items: StackItem[];
};

const { items } = Astro.props;
---

<div class="card-grid">
  {
    items.map((item) => (
      <div class="card">
        <strong class="stack-name">{item.name}</strong>
        <span class="stack-role">{item.role}</span>
      </div>
    ))
  }
</div>
