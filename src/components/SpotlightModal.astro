---
import SpotlightDropdown from './SpotlightSearch.astro';
import { searchItems } from '../data/search';

const serialized = JSON.stringify(searchItems);
---

<!-- Spotlight trigger button (used by keyboard shortcut) -->
<button
  class="spotlight-trigger"
  data-spotlight-trigger
  aria-label="打开搜索"
  title="搜索 (/)"
  hidden
>
  <svg
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle>
    <path d="m20 20-3.8-3.8"></path>
  </svg>
</button>

<!-- Spotlight overlay -->
<div class="spotlight-overlay" data-spotlight-overlay hidden>
  <div
    class="spotlight-modal"
    role="combobox"
    aria-expanded="false"
    aria-haspopup="listbox"
    aria-owns="spotlight-results"
  >
    <!-- Search input -->
    <div class="spotlight-input-row">
      <svg
        class="spotlight-input__icon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle>
        <path d="m20 20-3.8-3.8"></path>
      </svg>
      <input
        class="spotlight-input__field"
        type="search"
        placeholder="搜索项目、页面、链接…"
        autocomplete="off"
        data-spotlight-input
        aria-label="搜索全站内容"
      />
      <button class="spotlight-input__close" data-spotlight-close aria-label="关闭搜索" title="Esc">
        <span aria-hidden="true">×</span>
      </button>
    </div>

    <!-- Results -->
    <SpotlightDropdown items={searchItems} />

    <!-- Keyboard hints -->
    <div class="spotlight-hints">
      <span><kbd>↑</kbd><kbd>↓</kbd> 选择</span>
      <span><kbd>↵</kbd> 打开</span>
      <span><kbd>Esc</kbd> 关闭</span>
    </div>
  </div>
</div>

<script is:inline define:vars={{ serialized }}>
  import { normalize, scoreItem } from './search/search-utils.ts';
  (function () {
    if (typeof window === 'undefined') return;
    if (window.__spotlightReady) return;
    window.__spotlightReady = true;

    var overlay = document.querySelector('[data-spotlight-overlay]');
    var input = document.querySelector('[data-spotlight-input]');
    var closeBtn = document.querySelector('[data-spotlight-close]');
    var modal = document.querySelector('[data-spotlight-overlay] .spotlight-modal');
    if (!overlay || !input || !modal) return;

    var items = JSON.parse(serialized);
    var activeIndex = -1;
    var visibleLinks = [];

    function open() {
      overlay.hidden = false;
      overlay.style.opacity = '0';
      overlay.style.transform = 'translateY(-8px)';
      modal.setAttribute('aria-expanded', 'true');
      document.documentElement.classList.add('spotlight-open');
      requestAnimationFrame(function () {
        overlay.style.transition = 'opacity 200ms ease, transform 200ms ease';
        overlay.style.opacity = '1';
        overlay.style.transform = 'translateY(0)';
        input.value = '';
        activeIndex = -1;
        renderResults('');
        input.focus();
      });
    }

    function close() {
      overlay.style.opacity = '0';
      overlay.style.transform = 'translateY(-8px)';
      modal.setAttribute('aria-expanded', 'false');
      document.documentElement.classList.remove('spotlight-open');
      setTimeout(function () {
        overlay.hidden = true;
        overlay.style.transition = '';
        overlay.style.opacity = '';
        overlay.style.transform = '';
      }, 200);
    }

    function highlightText(text, query) {
      if (!query) return text;
      var idx = text.toLowerCase().indexOf(query.toLowerCase());
      if (idx === -1) return text;
      return (
        text.slice(0, idx) +
        '<em>' +
        text.slice(idx, idx + query.length) +
        '</em>' +
        text.slice(idx + query.length)
      );
    }

    function renderResults(query) {
      var normalized = normalize(query);
      var scored = items
        .map(function (item) {
          return { item: item, score: scoreItem(item, normalized) };
        })
        .filter(function (e) {
          return e.score > 0;
        })
        .sort(function (a, b) {
          return b.score - a.score;
        })
        .slice(0, 12);

      var dropdown = document.querySelector('[data-spotlight-results]');
      if (!dropdown) return;

      if (scored.length === 0) {
        dropdown.innerHTML =
          '<div style="padding:var(--space-6);text-align:center;color:var(--color-text-faint);font-size:var(--text-sm);">没有匹配的结果</div>';
        visibleLinks = [];
        activeIndex = -1;
        return;
      }

      var html = '';
      visibleLinks = [];
      scored.forEach(function (entry, i) {
        var item = entry.item;
        var titleHtml = highlightText(item.title, query);
        var descHtml = highlightText(item.desc, query);
        html +=
          '<a class="spotlight-item" href="' +
          item.href +
          '" data-spotlight-link data-spotlight-index="' +
          i +
          '">' +
          '<span class="spotlight-item__category">' +
          item.category +
          '</span>' +
          '<span class="spotlight-item__content">' +
          '<span class="spotlight-item__title">' +
          titleHtml +
          '</span>' +
          '<span class="spotlight-item__desc">' +
          descHtml +
          '</span>' +
          '</span>' +
          '<span class="spotlight-item__arrow" aria-hidden="true">↗</span>' +
          '</a>';
      });
      dropdown.innerHTML = html;
      visibleLinks = Array.from(dropdown.querySelectorAll('[data-spotlight-link]'));
      activeIndex = -1;
      updateActive();
    }

    function updateActive() {
      visibleLinks.forEach(function (link, i) {
        link.setAttribute('data-active', i === activeIndex ? 'true' : 'false');
      });
    }

    // Expose open/close globally for GlobalShortcuts
    window.__spotlightOpen = open;
    window.__spotlightClose = close;

    // Close button
    if (closeBtn) closeBtn.addEventListener('click', close);

    // Click outside to close
    overlay.addEventListener('click', function (e) {
      if (e.target === overlay) close();
    });

    // Listen for global overlay-close event (dispatched by GlobalShortcuts on Escape)
    document.addEventListener('site:overlay-close-all', function () {
      if (!overlay.hidden) close();
    });

    // Input search
    input.addEventListener('input', function () {
      activeIndex = -1;
      renderResults(input.value);
    });

    // Keyboard navigation
    input.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, visibleLinks.length - 1);
        updateActive();
        visibleLinks[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        updateActive();
        visibleLinks[activeIndex]?.scrollIntoView({ block: 'nearest' });
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && visibleLinks[activeIndex]) {
          visibleLinks[activeIndex].click();
        }
      } else if (e.key === 'Escape') {
        e.preventDefault();
        close();
      }
    });

    // Click on result
    overlay.addEventListener('click', function (e) {
      var link = e.target.closest('[data-spotlight-link]');
      if (link) {
        close();
        link.click();
      }
    });
  })();
</script>

<style is:global>
  .spotlight-trigger {
    position: absolute;
    width: 0;
    height: 0;
    opacity: 0;
    pointer-events: none;
  }

  .spotlight-overlay[hidden] {
    display: none !important;
  }

  .spotlight-overlay {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: var(--space-12) var(--space-4);
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
  }

  .spotlight-modal {
    width: 100%;
    max-width: 640px;
    background: var(--color-bg-raised);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-xl);
    overflow: hidden;
  }

  .spotlight-input-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border-bottom: 1px solid var(--color-border);
  }

  .spotlight-input__icon {
    width: 18px;
    height: 18px;
    color: var(--color-text-faint);
    flex-shrink: 0;
  }

  .spotlight-input__field {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: var(--text-base);
    font-weight: 500;
    color: var(--color-text);
    font-family: inherit;
    padding: 0;
  }

  .spotlight-input__field::placeholder {
    color: var(--color-text-faint);
  }

  .spotlight-input__close {
    width: 28px;
    height: 28px;
    border: none;
    background: transparent;
    color: var(--color-text-faint);
    font-size: 18px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-xs);
    transition:
      color var(--duration-fast),
      background var(--duration-fast);
    flex-shrink: 0;
  }

  .spotlight-input__close:hover {
    color: var(--color-text);
    background: var(--color-bg-subtle);
  }

  .spotlight-hints {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-3) var(--space-5);
    border-top: 1px solid var(--color-border);
    font-size: var(--text-xs);
    color: var(--color-text-faint);
  }

  .spotlight-hints kbd {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border: 1px solid var(--color-border);
    border-radius: 4px;
    background: var(--color-bg-subtle);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    box-shadow: 0 1px 0 var(--color-border);
    margin: 0 2px;
  }

  /* Search result highlight */
  .spotlight-item em {
    font-style: normal;
    color: var(--color-accent);
    font-weight: 600;
  }

  /* Body scroll lock */
  body.spotlight-open {
    overflow: hidden;
  }
</style>
